generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  customer
  admin
}

enum OAuthProvider {
  google
  github
  microsoft
}

enum PaymentMethod {
  stripe
  cod
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
}

enum DiscountType {
  percentage
  fixed
}

enum ReviewStatus {
  pending
  approved
  rejected
}

model User {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  email         String   @unique
  password      String?
  role          Role     @default(customer)
  phone         String?
  addresses     Json     @default("[]")
  avatar        String?
  emailVerified Boolean  @default(false)
  oauthAccounts Json     @default("[]")
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  orders   Order[]
  reviews  Review[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    String?  @db.Uuid
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    Category[] @relation("CategoryHierarchy")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products            Product[] @relation("ProductCategory")
  subcategoryProducts Product[] @relation("ProductSubcategory")

  @@map("categories")
}

model Product {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  slug           String   @unique
  description    String
  price          Float
  compareAtPrice Float?
  categoryId     String   @db.Uuid
  category       Category @relation("ProductCategory", fields: [categoryId], references: [id])
  subcategoryId  String?  @db.Uuid
  subcategory    Category? @relation("ProductSubcategory", fields: [subcategoryId], references: [id])
  images         String[]
  colors         String[]
  sizes          Json     @default("[]")
  tags           String[]
  isFeatured     Boolean  @default(false)
  isBestSeller   Boolean  @default(false)
  isSpecialCombo Boolean  @default(false)
  isCrazyDeal    Boolean  @default(false)
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reviews Review[]

  @@index([categoryId, price])
  @@map("products")
}

model Order {
  id                      String        @id @default(uuid()) @db.Uuid
  userId                  String        @db.Uuid
  user                    User          @relation(fields: [userId], references: [id])
  orderNumber             String        @unique
  items                   Json
  shippingAddress         Json
  paymentMethod           PaymentMethod
  paymentStatus           PaymentStatus @default(pending)
  orderStatus             OrderStatus   @default(pending)
  subtotal                Float
  discount                Float         @default(0)
  shippingCost            Float         @default(0)
  total                   Float
  couponId                String?       @db.Uuid
  coupon                  Coupon?       @relation(fields: [couponId], references: [id])
  stripePaymentIntentId   String?
  stripeCheckoutSessionId String?
  notes                   String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([orderStatus])
  @@map("orders")
}

model Coupon {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique
  description    String?
  discountType   DiscountType
  discountValue  Float
  minOrderAmount Float        @default(0)
  maxDiscount    Float?
  usageLimit     Int          @default(100)
  usedCount      Int          @default(0)
  expiresAt      DateTime
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  orders Order[]

  @@map("coupons")
}

model Review {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @db.Uuid
  product   Product      @relation(fields: [productId], references: [id])
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id])
  rating    Int
  title     String?
  comment   String
  status    ReviewStatus @default(pending)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([productId, userId])
  @@map("reviews")
}

model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  subtitle  String?
  image     String
  link      String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("banners")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique
  familyId         String
  deviceName       String    @default("Unknown device")
  ipAddress        String    @default("")
  userAgent        String    @default("")
  expiresAt        DateTime
  revokedAt        DateTime?
  lastUsedAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId, revokedAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  userId    String?  @db.Uuid
  ipAddress String   @default("")
  userAgent String   @default("")
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([action])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("auditlogs")
}

model OAuthState {
  id             String        @id @default(uuid()) @db.Uuid
  state          String        @unique
  provider       OAuthProvider
  codeVerifier   String
  redirectUri    String
  clientRedirect String        @default("/")
  expiresAt      DateTime

  @@map("oauthstates")
}

model OAuthExchange {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  refreshToken String
  userId       String   @db.Uuid
  expiresAt    DateTime

  @@map("oauthexchanges")
}
